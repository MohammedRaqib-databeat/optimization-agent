    <fieldPermissions>
        <field>Product2.GAM_Creative_Height__c</field>
        <readable>true</readable><editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>AdOrderItem.GAM_Delivered_Impressions__c</field>
        <readable>true</readable><editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>AdOrderItem.GAM_Delivered_Clicks__c</field>
        <readable>true</readable><editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>AdOrderItem.GAM_Delivery_Status__c</field>
        <readable>true</readable><editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>AdOrderItem.GAM_Last_Synced__c</field>
        <readable>true</readable><editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Quote.Amends_Order__c</field>
        <readable>true</readable><editable>true</editable>
    </fieldPermissions>

    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Optimization_Threshold__mdt</name>
    </customMetadataTypeAccesses>
</PermissionSet>
